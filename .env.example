# Supabase: Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Naver Cloud Platform → Maps → Application (Mobile Dynamic Map), Client ID
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=xxxx

# NAVER API HUB 검색 키(Key ID / Key)는 앱에 넣지 않는다 → supabase secrets set (README 참고)
